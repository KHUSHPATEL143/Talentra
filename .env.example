OPENAI_API_KEY=your-openai-api-key
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/garuda
REDIS_URL=redis://redis:6379/0
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
DEFAULT_MATCH_MODE=precision
MATCH_PRECISION_THRESHOLD=0.75
MATCH_RECALL_THRESHOLD=0.55
MAX_WORKERS=4
MAX_FILE_SIZE_MB=10
MAX_BATCH_FILES=50
REDIS_CACHE_TTL_SECONDS=3600
WEBHOOK_TIMEOUT_SECONDS=10
DEFAULT_API_KEY=
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_API_KEY=${DEFAULT_API_KEY}
